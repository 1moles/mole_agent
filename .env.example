# 复制为 .env（放在本项目根目录，或 ~/.mole-agent/.env）后填写。
# Mole 自己的设置统一用 MOLE_ 前缀；各供应商的 key 用各家通用的变量名。

# ---- 各供应商的 API key（供应商、地址、模型列表在 models.toml 里配置）----
# 只取消注释并填写你要用的；没有 key 的供应商在 /model 里不可选
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# MOONSHOT_API_KEY=
# ZHIPU_API_KEY=
# MAAS_API_KEY=
# 请求头鉴权用的变量（models.toml 里 headers 用 ${变量名} 引用），例如 ModelArts 在线服务：
# MODELARTS_TOKEN=
# SILICONFLOW_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- 模型调用的全局默认值（models.toml 里供应商可单独覆盖）----
# MOLE_TEMPERATURE=0.2
# MOLE_MAX_TOKENS=8192
# MOLE_TIMEOUT=120
# 内部网关自签证书时可设为 false（生产环境请保持 true）
MOLE_VERIFY_SSL=true

# ---- 单模型简易模式（没有 models.toml 时才生效，兼容旧配置）----
# MOLE_PROVIDER=OpenAI
# MOLE_API_BASE=https://api.deepseek.com/v1
# MOLE_API_KEY=sk-xxxxxxxxxxxxxxxx
# MOLE_MODEL=deepseek-flash

# ---- Agent 行为 ----
MOLE_AGENT_NAME=Mole
# 提示词与内置工具描述语言：cn / en
MOLE_LANGUAGE=cn
# 单轮对话内最多的 ReAct 迭代次数
MOLE_MAX_ITERATIONS=40

# ---- 安全 ----
# 执行前需要你确认的工具（逗号分隔）；留空表示全部自动执行
MOLE_CONFIRM_TOOLS=write_file,edit_file,bash
# 文件工具是否只允许访问当前项目目录（+ agent 私有工作区）
MOLE_RESTRICT_TO_PROJECT=true
# 追加的 bash 拒绝正则（用 ;; 分隔），会与内置规则合并
# MOLE_EXTRA_BASH_DENY=\bkubectl\s+delete\b;;\bterraform\s+destroy\b

# ---- 可选能力 ----
# 网页抓取工具（fetch_webpage）
MOLE_ENABLE_WEB=false
# 上下文压缩/组装 rails（长对话建议开启）
MOLE_ENABLE_CONTEXT_RAILS=true
# 子 agent（explore_agent 只读探索、code_reviewer 代码检视）；各自用哪个模型在 models.toml 的 [subagents] 里配
MOLE_ENABLE_SUBAGENTS=true
# 工具调用审计日志：~/.mole-agent/audit.jsonl
MOLE_AUDIT_LOG=true
